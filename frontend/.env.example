# Leave empty when the API is served from the same origin (dev proxy or SERVE_CLIENT=true).
# Set to the API origin when the frontend is hosted separately, e.g. https://api.yourdomain.com
VITE_API_URL=

# Where the Vite dev server proxies /api, /uploads, /sitemap.xml and /robots.txt.
VITE_DEV_API_TARGET=http://localhost:5000

# Public site URL — used for canonical and social-sharing URLs.
VITE_SITE_URL=http://localhost:5173

# Fallbacks used only until business settings load from the API (or if the API is down),
# so the WhatsApp button and phone number keep working. Keep in sync with Admin → Settings.
VITE_BUSINESS_NAME=Brush & Beam Painting Co.
VITE_WHATSAPP_NUMBER=15550001234
VITE_PHONE=+1 555 000 1234
