# Public site URL, used for canonical links, social sharing and sitemap.xml.
# On Vercel this defaults to the project's production domain, so it's optional there.
VITE_SITE_URL=

# Google Maps JavaScript API key, used to show live Google reviews.
# Enable "Maps JavaScript API" and "Places API (New)" for it, and restrict it to
# your site's domains (HTTP referrers). Leave empty to hide live reviews.
VITE_GOOGLE_MAPS_API_KEY=
