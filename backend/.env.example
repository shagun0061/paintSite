# ─── Server ─────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# MongoDB connection string. Use "memory" for a throwaway in-memory database
# (development only — auto-seeded on start, wiped on stop).
#   Local:  mongodb://127.0.0.1:27017/paintsite
#   Atlas:  mongodb+srv://<user>:<password>@<cluster>/paintsite
MONGODB_URI=memory

# Long random string, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# Frontend origin(s) allowed to call the API (comma-separated).
CLIENT_ORIGIN=http://localhost:5173
# Public site URL — used for canonical URLs, sitemap.xml and robots.txt.
SITE_URL=http://localhost:5173

# Cookies are always Secure in production; set true if you test over HTTPS locally.
COOKIE_SECURE=false
# Set to 1 when running behind one reverse proxy / load balancer (Render, Heroku, Nginx).
TRUST_PROXY=

# ─── Uploads ───────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# Serve frontend/dist from this server (single-origin deployment).
SERVE_CLIENT=false

# ─── First admin account ───────────────────────────────
# Used by `npm run seed` (and automatically with MONGODB_URI=memory) when no
# admin exists yet. Leave ADMIN_PASSWORD empty to have one generated and printed.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# ─── Google reviews (optional) ─────────────────────────
# Official Places API (New) — shows the business rating and up to 5 Google
# reviews with attribution. Restrict the key to the Places API and to your
# server's IP. Leave empty to show "Read / Write a Google review" links only.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
